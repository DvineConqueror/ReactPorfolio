{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "henry-alicoben-portfolio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-26",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "CONTACT_FROM_EMAIL": "Portfolio <onboarding@resend.dev>", "CONTACT_TO_EMAIL": "dominicalicoben2016@gmail.com" },
  "ratelimits": [{ "name": "CONTACT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }]
}
